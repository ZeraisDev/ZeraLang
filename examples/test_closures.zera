// test_closures.zera — capture-by-value lambda closures
// run with: zera --vm test_closures.zera

define make_adder(n) {
    set adder to func(x) {
        return x + n
    }
    return adder
}

set add5 to make_adder(5)
set add10 to make_adder(10)

show add5(3)      // expect 8
show add10(3)     // expect 13
show add5(100)    // expect 105 — same closure reused, still adds 5, not 100

// Capture-by-value: each closure snapshots i at the moment it's *created*,
// not a shared reference to the outer i.
set fns to []
set i to 0
while i < 3 {
    set fns to push(fns, func() {
        return i
    })
    set i to i + 1
}

show fns[0]()   // expect 0
show fns[1]()   // expect 1
show fns[2]()   // expect 2 (NOT 3,3,3 — that would mean capture-by-reference)
